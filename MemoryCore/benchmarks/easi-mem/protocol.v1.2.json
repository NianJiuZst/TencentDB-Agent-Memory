{
  "protocolVersion": "easi-mem-long-dialogue-v1.2.0",
  "supersedes": "easi-mem-long-dialogue-v1.1.0",
  "changeReason": "V1.1 development results showed unsafe low-cost leaves. V1.2 adds an always-eligible best-static policy, conservative 0.90-0.98 leaf confidence, and simultaneous RecallAny/RecallAll/MacroRecall development guards. All baselines are rerun.",
  "dataset": {
    "name": "LongMemEval-S-cleaned",
    "source": "https://huggingface.co/datasets/xiaowu0162/longmemeval-cleaned/resolve/main/longmemeval_s_cleaned.json",
    "revision": "98d7416c24c778c2fee6e6f3006e7a073259d48f",
    "sha256": "d6f21ea9d60a0d56f34a05b609c79c88a451d2ae03597821ea3d5a9678c3a442"
  },
  "split": {
    "method": "category-stratified SHA-256 ordering",
    "seed": 20260822,
    "train": 0.6,
    "dev": 0.2,
    "test": 0.2
  },
  "selection": {
    "runtimeFeatures": "query plus base Top-5 scout only",
    "forbiddenFeatures": ["question_type", "answer", "gold evidence", "split"],
    "leafConfidenceGrid": [0.9, 0.95, 0.98],
    "fallback": "development-selected best-static profile",
    "developmentGuards": ["RecallAnySession", "RecallAllSessions", "MacroSessionRecall"]
  },
  "promotion": {
    "maxRecallRegression": 0.01,
    "minTokenReduction": 0.1,
    "pairedBootstrapSamples": 5000,
    "minUtility95CiLowerBound": 0
  }
}
